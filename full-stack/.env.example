DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SESSION_SECRET=your-random-secret-at-least-32-chars
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
CRON_SECRET=your-random-cron-secret

# scripts/seed.js、scripts/update-accounts.js（僅執行該些腳本時需要，不要用弱密碼）
ROCK_PASSWORD=
JIEJIE_PASSWORD=

# scripts/ 下會寫入資料庫的腳本（seed.js / update-accounts.js / restore.js /
# cleanup-old-admin.js）執行前的安全確認。這是刻意設計成麻煩的防呆機制：
# 值必須是 `<operation>@<db-host>`（例如 `seed@ep-xxx.aws.neon.tech`），
# operation 為該腳本名稱、db-host 為當下 DATABASE_URL 解析出的 hostname，
# 兩者缺一都會被拒絕（殘留值無法冒用到別支腳本或別的資料庫）。
# 只在確定要對 DATABASE_URL 指向的資料庫執行該操作時才臨時設定，
# 不要長期放在 .env 裡。
DB_WRITE_CONFIRM=
